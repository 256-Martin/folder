# ---------------------------------------------------------------------------
# UGABRUSH MANUFACTURING SYSTEM — environment
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required.
#
# Local server:
#   postgresql://postgres:YOUR_PASSWORD@localhost:5432/ugabrush
#
# Neon / Supabase / Railway (use the POOLED connection string):
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ugabrush?sslmode=require
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ugabrush

# TLS is ON for any remote host and OFF for localhost. Override only if needed:
#   off        never use TLS
#   no-verify  use TLS but skip certificate verification (self-signed certs)
# DATABASE_SSL=

# Maximum pooled connections. Defaults to 10, or 1 on Vercel.
# DATABASE_POOL_MAX=10

# Secret used to sign session cookies. MUST be set to a strong value in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-insecure-secret-change-me-in-production-0000000000

# Label shown in the sidebar
NEXT_PUBLIC_ENV_LABEL=Development
